# CPU at maximum frequency
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y

# Compiler: -O2 instead of debug -Og
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Enable External RAM (PSRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_120M=y

# Legacy ESP-IDF v4 compatibility for SPIRAM
CONFIG_ESP32_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_SUPPORT=y

# Enable Bluetooth Low Energy (NimBLE)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# Flash configuration
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Disable Watchdog to prevent resets during long CPU-bound rendering loops
CONFIG_ESP_INT_WDT=n
CONFIG_ESP_TASK_WDT=n

# Allow placing BSS segment in external RAM (PSRAM)
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Custom Partition Table configuration for 8MB Flash
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Enable WebSockets support in HTTP Server
CONFIG_HTTPD_WS_SUPPORT=y

